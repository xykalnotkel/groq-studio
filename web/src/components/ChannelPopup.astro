---
/**
 * Popup ajakan gabung saluran WhatsApp — versi 3.0.
 *
 * Gambar header dibuat ulang penuh dengan rasio 4:3 dan gaya morphing:
 * gradien yang "meleleh", elemen melayang dengan motion blur, dan teks
 * tebal-lembut. Tanpa emoji.
 *
 * - Tombol X untuk menutup
 * - Centang "Jangan tampilkan lagi" (disimpan di localStorage)
 * - Tombol "Laporkan bug" → chat WhatsApp
 * - Credit "Built in XyVerse" memakai logo resmi XyVerse
 */
import { APP } from '../data/app.js';
---

<div class="cp-overlay" id="channel-popup" hidden>
  <div class="cp-card" role="dialog" aria-modal="true" aria-labelledby="cp-title">
    <!-- Header 4:3: gradien meleleh + elemen melayang + motion blur -->
    <div class="cp-hero">
      <div class="cp-melt" aria-hidden="true"></div>
      <span class="cp-orb cp-orb-1" aria-hidden="true"></span>
      <span class="cp-orb cp-orb-2" aria-hidden="true"></span>
      <span class="cp-orb cp-orb-3" aria-hidden="true"></span>
      <span class="cp-orb cp-orb-4" aria-hidden="true"></span>

      <div class="cp-hero-text">
        <span class="cp-pill">
          <img src="/xyverse_icon_white.png" alt="" width="16" height="16" />
          XyVerse
        </span>
        <h2>Saluran WhatsApp</h2>
        <p>Update, template prompt, dan tips menulis — langsung ke WhatsApp kamu</p>
      </div>

      <div class="cp-credit-badge">
        <span>Built in</span>
        <img src="/xyverse_wordmark_white.png" alt="XyVerse" height="13" />
      </div>

      <button class="cp-close" id="cp-close" aria-label="Tutup" title="Tutup">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2 2l10 10M12 2L2 12" stroke="#fff" stroke-width="2.2" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <div class="cp-body">
      <h3 id="cp-title">Gabung {APP.waChannelName}</h3>
      <p class="cp-desc">
        Dapatkan kabar fitur baru, template prompt, dan tips nulis pakai AI —
        langsung di WhatsApp kamu. Gratis, dan bisa keluar kapan saja.
      </p>

      <ul class="cp-list">
        <li>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="#25D366" aria-hidden="true"><path d="M11 21h-1l1-7H7.5c-.88 0-.33-.75-.31-.78C8.48 10.94 10.42 7.54 13.01 3h1l-1 7h3.51c.4 0 .62.19.4.66C12.97 17.55 11 21 11 21Z"/></svg>
          Update fitur duluan sebelum rilis
        </li>
        <li>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="#7C5CFF" aria-hidden="true"><path d="M12 2l2.1 5.7L20 10l-5.9 2.3L12 18l-2.1-5.7L4 10l5.9-2.3L12 2Z"/></svg>
          Template prompt &amp; ide konten gratis
        </li>
        <li>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="#22D3EE" aria-hidden="true"><path d="M4 4h16a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H9l-5 4V6a2 2 0 0 1 0-2Z"/></svg>
          Tanya jawab bareng pengguna lain
        </li>
      </ul>

      <a class="btn green cp-join" href={APP.waChannelUrl} target="_blank" rel="noopener">
        Gabung Sekarang
      </a>
      <p class="cp-url">{APP.waChannelUrl}</p>

      <label class="cp-check">
        <input type="checkbox" id="cp-dontshow" />
        <span class="cp-box" aria-hidden="true"></span>
        <span>Jangan tampilkan lagi</span>
      </label>

      <a class="cp-bug" href={APP.bugReportUrl} target="_blank" rel="noopener">
        Laporkan bug
      </a>
    </div>
  </div>
</div>

<style>
  .cp-overlay {
    position: fixed; inset: 0; z-index: 100;
    display: grid; place-items: center;
    padding: 18px;
    background: rgba(5, 5, 12, .62);
    backdrop-filter: blur(6px);
    animation: fade .28s ease both;
    overflow-y: auto;
  }
  .cp-overlay[hidden] { display: none; }
  @keyframes fade { from { opacity: 0 } to { opacity: 1 } }

  .cp-card {
    width: 100%; max-width: 420px;
    background: #12121f;
    border: 1px solid #262640;
    border-radius: 26px;
    overflow: hidden;
    box-shadow: 0 40px 90px rgba(0, 0, 0, .6);
    animation: pop .42s cubic-bezier(.2,0,0,1) both;
  }
  @keyframes pop {
    from { opacity: 0; transform: translateY(14px) scale(.94) }
    to   { opacity: 1; transform: none }
  }

  /* ── Header 4:3 ─────────────────────────────────────────────── */
  .cp-hero {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #12122a, #1b1035);
  }

  /* Gradien meleleh: tiga blob besar bergeser pelan ke bawah. */
  .cp-melt { position: absolute; inset: -40%; filter: blur(2px); }
  .cp-melt::before, .cp-melt::after, .cp-hero .cp-melt + .cp-orb::before {
    content: '';
  }
  .cp-melt {
    background:
      radial-gradient(42% 60% at 24% 22%, rgba(124,92,255,.85), transparent 70%),
      radial-gradient(38% 55% at 82% 16%, rgba(37,211,102,.5), transparent 70%),
      radial-gradient(50% 65% at 52% 82%, rgba(244,114,182,.42), transparent 72%);
    animation: melt 9s ease-in-out infinite alternate;
    transform-origin: 50% 20%;
  }
  @keyframes melt {
    0%   { transform: translateY(-4%) scaleY(1) rotate(-2deg); }
    50%  { transform: translateY(5%)  scaleY(1.12) rotate(1.5deg); }
    100% { transform: translateY(9%)  scaleY(1.2) rotate(-1deg); }
  }

  /* Elemen melayang + motion blur (blur searah gerak). */
  .cp-orb {
    position: absolute;
    border-radius: 50%;
    display: grid; place-items: center;
    filter: blur(1.5px);
  }
  .cp-orb-1 {
    width: 74px; height: 74px; left: 12%; top: 24%;
    background: rgba(37, 211, 102, .85);
    box-shadow: 0 0 30px 4px rgba(37, 211, 102, .55);
    animation: float1 7s ease-in-out infinite;
  }
  .cp-orb-1::after {
    content: ''; width: 26px; height: 26px;
    background: #fff; border-radius: 50% 50% 50% 4px;
    transform: rotate(45deg); opacity: .92;
  }
  .cp-orb-2 {
    width: 54px; height: 54px; right: 12%; top: 16%;
    background: rgba(124, 92, 255, .9);
    box-shadow: 0 0 26px 4px rgba(124, 92, 255, .55);
    animation: float2 8s ease-in-out infinite;
  }
  .cp-orb-2::after {
    content: ''; width: 20px; height: 20px; background: #fff;
    clip-path: polygon(50% 0, 63% 37%, 100% 50%, 63% 63%, 50% 100%, 37% 63%, 0 50%, 37% 37%);
  }
  .cp-orb-3 {
    width: 44px; height: 44px; right: 26%; bottom: 20%;
    background: rgba(34, 211, 238, .85);
    box-shadow: 0 0 22px 3px rgba(34, 211, 238, .5);
    animation: float3 6.4s ease-in-out infinite;
  }
  .cp-orb-3::after {
    content: ''; width: 18px; height: 3.6px; background: #fff; border-radius: 2px;
    box-shadow: 0 -6px 0 #fff, 0 6px 0 #fff;
  }
  .cp-orb-4 {
    width: 30px; height: 30px; left: 24%; bottom: 16%;
    background: rgba(244, 114, 182, .8);
    box-shadow: 0 0 18px 3px rgba(244, 114, 182, .5);
    animation: float4 7.6s ease-in-out infinite;
  }
  @keyframes float1 {
    0%, 100% { transform: translate(0, 0);      filter: blur(1.5px); }
    50%      { transform: translate(22px, -18px); filter: blur(4px); }
  }
  @keyframes float2 {
    0%, 100% { transform: translate(0, 0);        filter: blur(1.5px); }
    50%      { transform: translate(-24px, 20px);  filter: blur(4.5px); }
  }
  @keyframes float3 {
    0%, 100% { transform: translate(0, 0);       filter: blur(1.5px); }
    50%      { transform: translate(26px, 14px);  filter: blur(4px); }
  }
  @keyframes float4 {
    0%, 100% { transform: translate(0, 0);        filter: blur(1.5px); }
    50%      { transform: translate(-14px, -22px); filter: blur(3.5px); }
  }

  /* Teks tebal-lembut di tengah. */
  .cp-hero-text {
    position: relative; z-index: 2;
    text-align: center; padding: 26px 28px 8px;
  }
  .cp-pill {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 5px 13px; border-radius: 999px;
    background: rgba(255,255,255,.13);
    border: 1px solid rgba(255,255,255,.25);
    color: #fff; font-size: 12px; font-weight: 800; letter-spacing: .6px;
  }
  .cp-hero-text h2 {
    margin: 14px 0 8px; color: #fff;
    font-size: 30px; line-height: 1.15; font-weight: 800; letter-spacing: -.6px;
    text-shadow: 0 4px 18px rgba(0,0,0,.35);
  }
  .cp-hero-text p {
    margin: 0 auto; max-width: 300px;
    color: rgba(255,255,255,.88);
    font-size: 13.5px; font-weight: 500; line-height: 1.45;
  }

  .cp-credit-badge {
    position: absolute; z-index: 2; bottom: 12px; left: 50%;
    transform: translateX(-50%);
    display: flex; align-items: center; gap: 7px;
    padding: 5px 12px; border-radius: 999px;
    background: rgba(0,0,0,.3);
    color: rgba(255,255,255,.75);
    font-size: 10.5px; font-weight: 600;
    white-space: nowrap;
  }

  .cp-close {
    position: absolute; top: 12px; right: 12px; z-index: 3;
    width: 34px; height: 34px; border: 0; border-radius: 50%;
    background: rgba(0, 0, 0, .45); color: #fff;
    cursor: pointer;
    display: grid; place-items: center;
    transition: background .2s, transform .2s;
  }
  .cp-close:hover { background: rgba(0, 0, 0, .7); transform: rotate(90deg); }

  /* ── Isi ────────────────────────────────────────────────────── */
  .cp-body { padding: 18px 24px 20px; }
  .cp-body h3 {
    font-size: 20px; font-weight: 800; letter-spacing: -.4px; margin-bottom: 8px;
  }
  .cp-desc { font-size: 13.6px; color: #a9a9c4; line-height: 1.6; margin-bottom: 14px; }

  .cp-list { list-style: none; margin-bottom: 16px; }
  .cp-list li {
    display: flex; align-items: center; gap: 9px;
    font-size: 13.5px; margin-bottom: 7px; color: #d6d6e6;
  }
  .cp-list svg { flex: none; }

  .cp-join { width: 100%; margin-bottom: 4px; }
  .cp-url {
    text-align: center; font-size: 10.5px; color: #55556e;
    margin-bottom: 8px; word-break: break-all;
  }

  .cp-check {
    display: flex; align-items: center; gap: 10px;
    font-size: 13.5px; font-weight: 600; cursor: pointer;
    padding: 6px 2px; user-select: none;
  }
  .cp-check input { position: absolute; opacity: 0; width: 0; height: 0; }
  .cp-box {
    width: 21px; height: 21px; flex: none;
    border: 1.6px solid #34344f; border-radius: 7px;
    display: grid; place-items: center;
    transition: all .18s;
  }
  .cp-check input:checked + .cp-box {
    background: linear-gradient(120deg, var(--indigo), var(--violet));
    border-color: transparent;
  }
  .cp-check input:checked + .cp-box::after {
    content: ''; width: 10px; height: 6px;
    border-left: 2.2px solid #fff; border-bottom: 2.2px solid #fff;
    transform: rotate(-45deg) translate(1px, -1px);
  }

  .cp-bug {
    display: block; text-align: center; margin-top: 8px;
    font-size: 12.8px; font-weight: 600; color: #7f7f9c;
  }
  .cp-bug:hover { color: var(--pink); }
</style>

<script>
  const KEY = 'xystudio:hide-channel-popup';
  const COUNT_KEY = 'xystudio:launch-count';
  const overlay = document.getElementById('channel-popup');
  const closeBtn = document.getElementById('cp-close');
  const checkbox = document.getElementById('cp-dontshow');

  function closePopup() {
    if (checkbox && checkbox.checked) {
      try { localStorage.setItem(KEY, '1'); } catch (e) {}
    }
    if (overlay) overlay.hidden = true;
    document.body.style.overflow = '';
  }

  if (overlay && closeBtn) {
    closeBtn.addEventListener('click', closePopup);
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) closePopup();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !overlay.hidden) closePopup();
    });

    let hidden = false;
    let count = 0;
    try {
      hidden = localStorage.getItem(KEY) === '1';
      count = parseInt(localStorage.getItem(COUNT_KEY) || '0', 10) + 1;
      localStorage.setItem(COUNT_KEY, String(count));
    } catch (e) {}

    // Tampil di kunjungan pertama, lalu tiap kunjungan ke-4.
    if (!hidden && (count <= 1 || count % 4 === 0)) {
      setTimeout(() => {
        overlay.hidden = false;
        document.body.style.overflow = 'hidden';
      }, 900);
    }
  }
</script>
