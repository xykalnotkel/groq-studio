---
import Base from '../layouts/Base.astro';
import { APP } from '../data/app.js';
---

<Base current="papan" title={`Papan token — ${APP.name}`} description="Papan peringkat penghabis token Groq di XyStudio AI.">
  <main class="wrap board">
    <header class="hero card">
      <p class="kicker">Papan penghabis token</p>
      <h1>Siapa paling rakus token</h1>
      <p class="muted">
        Masuk pakai email dan PIN. Setiap generate di aplikasi atau web app
        nambah skor. Ada podium 1-2-3, papan sepanjang masa, dan minggu ini.
      </p>
    </header>

    <section class="card auth" id="auth-card">
      <div id="auth-in" hidden>
        <div class="me">
          <div class="avatar" id="me-avatar">?</div>
          <div>
            <strong id="me-name">—</strong>
            <p class="muted small" id="me-mail"></p>
            <p class="rank-line" id="me-rank">Belum ada peringkat</p>
          </div>
          <button class="chip" id="btn-out" type="button">Keluar</button>
        </div>
      </div>
      <div id="auth-out">
        <div class="tabs">
          <button class="chip active" id="tab-reg" type="button">Daftar</button>
          <button class="chip" id="tab-in" type="button">Masuk</button>
        </div>
        <label class="field" id="name-field">
          <span class="label">Nama tampilan</span>
          <input id="name" maxlength="24" placeholder="Misal: Kal" />
        </label>
        <label class="field">
          <span class="label">Email</span>
          <input id="email" type="email" placeholder="kamu@email.com" />
        </label>
        <label class="field">
          <span class="label">PIN 4-6 digit</span>
          <input id="pin" inputmode="numeric" maxlength="6" placeholder="••••" />
        </label>
        <button class="btn" id="btn-go" type="button">Daftar</button>
        <p class="muted small" id="auth-status"></p>
      </div>
    </section>

    <section class="card">
      <div class="tabs">
        <button class="chip active" id="tab-all" type="button">Sepanjang masa</button>
        <button class="chip" id="tab-week" type="button">Minggu ini</button>
      </div>
      <div class="podium" id="podium"></div>
      <div class="list" id="list">
        <p class="muted">Memuat papan…</p>
      </div>
      <p class="muted small" id="meta"></p>
    </section>
  </main>
</Base>

<script>
  const API = '/api/leaderboard';
  const STORE = 'xystudio:profile';
  const $ = (id) => document.getElementById(id);
  let weekly = false;
  let register = true;
  let board = { all: [], weekly: [], me: null, meWeek: null, total: 0, week: '' };

  function loadProfile() {
    try { return JSON.parse(localStorage.getItem(STORE) || 'null'); } catch { return null; }
  }
  function saveProfile(p) {
    try { p ? localStorage.setItem(STORE, JSON.stringify(p)) : localStorage.removeItem(STORE); } catch {}
  }
  function formatTokens(n) {
    if (n >= 1000000) return (n / 1000000).toFixed(1) + ' jt';
    if (n >= 1000) return (n / 1000).toFixed(1) + ' rb';
    return String(n || 0);
  }
  function escapeHtml(s) {
    return String(s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function renderAuth() {
    const p = loadProfile();
    $('auth-in').hidden = !p;
    $('auth-out').hidden = !!p;
    if (p) {
      $('me-name').textContent = p.name || 'Anonim';
      $('me-mail').textContent = p.email || '';
      $('me-avatar').textContent = (p.name || '?').slice(0, 1).toUpperCase();
      const mine = weekly ? board.meWeek : board.me;
      $('me-rank').textContent = mine
        ? `Peringkat #${mine.rank} · ${formatTokens(weekly ? mine.weekTokens : mine.tokens)} token`
        : 'Belum ada peringkat. Generate dulu di aplikasi.';
    }
    $('name-field').hidden = !register;
    $('btn-go').textContent = register ? 'Daftar' : 'Masuk';
    $('tab-reg').classList.toggle('active', register);
    $('tab-in').classList.toggle('active', !register);
  }

  function renderBoard() {
    const rows = weekly ? board.weekly : board.all;
    const key = weekly ? 'weekTokens' : 'tokens';
    const podium = [rows[1], rows[0], rows[2]];
    const places = [2, 1, 3];
    $('podium').innerHTML = places.map((place, i) => {
      const row = podium[i];
      return `<article class="pod p${place}">
        <b>#${place}</b>
        <strong>${escapeHtml(row?.name || 'Kosong')}</strong>
        <span>${row ? formatTokens(row[key]) : '—'}</span>
      </article>`;
    }).join('');
    if (!rows.length) {
      $('list').innerHTML = '<p class="muted">Papan masih sepi. Daftar, lalu generate.</p>';
    } else {
      $('list').innerHTML = rows.map((row) => `
        <div class="row${board.me && board.me.id === row.id ? ' me' : ''}">
          <span class="rk">#${row.rank}</span>
          <span class="nm">${escapeHtml(row.name)}</span>
          <span class="gn">${row.generates} generate</span>
          <span class="tk">${formatTokens(row[key])}</span>
        </div>`).join('');
    }
    $('meta').textContent = `${board.total || 0} penulis${board.week ? ' · ' + board.week : ''}`;
    renderAuth();
  }

  async function fetchBoard() {
    const p = loadProfile();
    const url = p?.email ? API + '?me=' + encodeURIComponent(p.email) : API;
    const r = await fetch(url);
    if (!r.ok) throw new Error('Papan belum siap.');
    board = await r.json();
    renderBoard();
  }

  async function submit(action) {
    const name = $('name').value.trim();
    const email = $('email').value.trim();
    const pin = $('pin').value.trim();
    $('auth-status').textContent = 'Menyimpan…';
    try {
      const r = await fetch(API, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action, name, email, pin, tokens: 0, generates: 0 }),
      });
      const data = await r.json();
      if (!r.ok) throw new Error(data.error || 'Gagal');
      saveProfile({ email, name: data.profile?.name || name, pin });
      board = data;
      $('auth-status').textContent = '';
      renderBoard();
    } catch (err) {
      $('auth-status').textContent = err.message || 'Gagal masuk.';
    }
  }

  $('tab-reg').onclick = () => { register = true; renderAuth(); };
  $('tab-in').onclick = () => { register = false; renderAuth(); };
  $('tab-all').onclick = () => { weekly = false; $('tab-all').classList.add('active'); $('tab-week').classList.remove('active'); renderBoard(); };
  $('tab-week').onclick = () => { weekly = true; $('tab-week').classList.add('active'); $('tab-all').classList.remove('active'); renderBoard(); };
  $('btn-go').onclick = () => submit(register ? 'register' : 'login');
  $('btn-out').onclick = () => { saveProfile(null); renderAuth(); };

  fetchBoard().catch((err) => {
    $('list').innerHTML = `<p class="muted">${escapeHtml(err.message)}</p>`;
  });
  renderAuth();
</script>

<style>
  .board { padding: 28px 0 50px; display: grid; gap: 16px; }
  .hero { padding: 28px 24px; }
  h1 { font-size: 30px; font-weight: 800; letter-spacing: -.6px; margin: 6px 0 8px; }
  .kicker { font-size: 12px; font-weight: 800; letter-spacing: 1.4px; text-transform: uppercase; color: var(--cyan); }
  .tabs { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 14px; }
  .field { display: block; margin-bottom: 10px; }
  .me { display: flex; align-items: center; gap: 12px; }
  .me > div { flex: 1; min-width: 0; }
  .avatar { width: 48px; height: 48px; border-radius: 16px; display: grid; place-items: center;
            font-weight: 800; color: #fff; background: linear-gradient(120deg, var(--violet), var(--cyan)); flex: none; }
  .rank-line { margin: 4px 0 0; font-weight: 800; color: var(--violet); font-size: 13px; }
  .podium { display: grid; grid-template-columns: 1fr 1.1fr 1fr; gap: 10px; align-items: end; margin-bottom: 16px; }
  .pod { border-radius: 18px; padding: 14px 10px; text-align: center; border: 1px solid var(--line);
         display: flex; flex-direction: column; gap: 4px; min-height: 110px; justify-content: flex-end; }
  .pod b { font-size: 18px; }
  .pod.p1 { min-height: 150px; background: linear-gradient(180deg, rgba(251,191,36,.35), rgba(251,191,36,.06)); border-color: rgba(251,191,36,.5); }
  .pod.p2 { min-height: 124px; background: linear-gradient(180deg, rgba(148,163,184,.28), rgba(148,163,184,.06)); }
  .pod.p3 { min-height: 108px; background: linear-gradient(180deg, rgba(217,119,6,.28), rgba(217,119,6,.06)); }
  .list { display: grid; gap: 6px; }
  .row { display: grid; grid-template-columns: 48px 1fr auto auto; gap: 10px; align-items: center;
         padding: 10px 12px; border-radius: 14px; border: 1px solid var(--line); }
  .row.me { border-color: rgba(124,92,255,.5); background: rgba(124,92,255,.1); }
  .rk { font-weight: 800; }
  .nm { font-weight: 700; }
  .gn { font-size: 12px; color: var(--muted); }
  .tk { font-weight: 800; color: var(--violet); }
  @media (max-width: 700px) {
    .row { grid-template-columns: 40px 1fr auto; }
    .gn { display: none; }
    h1 { font-size: 24px; }
  }
</style>
