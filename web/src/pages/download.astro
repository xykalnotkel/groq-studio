---
import Base from '../layouts/Base.astro';
import { APP, DOWNLOADS } from '../data/app.js';

const shots = [
  { webp: '/shots/01_home.webp', png: '/shots/01_home.png', alt: 'Halaman utama XyStudio AI' },
  { webp: '/shots/02_hasil.webp', png: '/shots/02_hasil.png', alt: 'Contoh artikel yang dihasilkan' },
  { webp: '/shots/03_riwayat.webp', png: '/shots/03_riwayat.png', alt: 'Halaman riwayat' },
  { webp: '/shots/04_setelan.webp', png: '/shots/04_setelan.png', alt: 'Setelan dan API key' },
  { webp: '/shots/05_mode.webp', png: '/shots/05_mode.png', alt: 'Daftar mode generate' },
  { webp: '/shots/06_popup.webp', png: '/shots/06_popup.png', alt: 'Popup saluran WhatsApp' },
];
---

<Base current="download" title={`Download ${APP.name}`} description={`Unduh APK ${APP.name} ${APP.version} untuk Android. Tautan resmi: ${APP.downloadUrl}. Belum di Play Store karena biaya daftar developer belum ada — bukan malware.`}>
  <main class="wrap dl-page">
    <section class="card dl-card">
      <p class="kicker">Unduhan resmi</p>
      <h1>Download {APP.name}</h1>
      <p class="muted" style="margin:10px 0 18px">
        Versi {APP.version} untuk Android 7 ke atas. File diambil lewat
        <code>{APP.downloadUrl.replace('https://', '')}</code> — bukan tautan GitHub.
        Pilih sesuai HP kamu.
      </p>
      <div class="dl-list">
        {DOWNLOADS.map((d) => (
          <div class="dl-row">
            <div>
              <strong>{d.label}</strong>
              <p class="muted small">{d.note}</p>
              <p class="muted small">{d.file}</p>
              {d.sha256 && <p class="muted small sha">SHA-256 {d.sha256}</p>}
            </div>
            <a class={d.primary ? 'btn sm' : 'btn sm ghost'} href={d.href}>{d.primary ? 'Unduh' : 'APK'}</a>
          </div>
        ))}
      </div>
      <p class="muted small" style="margin-top:16px">
        Pakai <strong>Android 64-bit</strong> supaya ukuran pasang tidak membengkak.
        Berkas Universal memuat dua arsitektur — itu yang bikin terasa 100&nbsp;MB.
        Android bisa memperingatkan "sumber tidak dikenal"; izinkan pasang dari browser, lalu buka filenya.
      </p>
    </section>

    <aside class="card dl-card">
      <h2>Cara pasang</h2>
      <ol class="prose" style="margin-top:10px">
        <li>Kalau sudah pasang 3.2.1 atau lebih lama, uninstall dulu (tanda tangan APK berubah di 3.2.2).</li>
        <li>Unduh APK 64-bit kalau HP-mu keluaran beberapa tahun terakhir.</li>
        <li>Buka file dari notifikasi unduhan.</li>
        <li>Kalau diminta, izinkan pasang dari sumber ini.</li>
        <li>Buka {APP.name}. API key Groq bisa diisi di Setelan (gratis) bila belum tertanam.</li>
      </ol>
      <p class="muted small" style="margin-top:12px">
        Butuh bantuan? Buka <a href="/support">halaman Bantuan</a>
        atau <a href="#" data-bug-open>laporkan bug</a>.
      </p>
      <div style="margin-top:18px;display:flex;flex-direction:column;gap:10px">
        <a class="btn" href="/app">Coba dulu di browser</a>
        <a class="btn ghost" href="/changelog">Lihat changelog</a>
      </div>
    </aside>

    <section class="card dl-wide">
      <h2>Tampilan aplikasi</h2>
      <p class="muted small" style="margin:6px 0 14px">Screenshot dari APK {APP.name}, bukan mockup.</p>
      <div class="shots">
        {shots.map((s) => (
          <div class="phone-shot">
            <picture>
              <source srcset={s.webp} type="image/webp" />
              <img src={s.png} alt={s.alt} width="540" height="960" loading="lazy" decoding="async" />
            </picture>
          </div>
        ))}
      </div>
    </section>

    <section class="card dl-wide" id="keamanan">
      <h2>Keamanan &amp; Play Store</h2>
      <div class="safe-grid">
        <div>
          <h3>Kenapa belum di Play Store?</h3>
          <p class="muted">
            Daftar sebagai developer Google Play berbayar sekitar 25 USD sekali.
            Modal itu belum ada, jadi APK diedarkan langsung dari situs ini.
            Bukan karena aplikasi ditolak, bukan karena virus, dan bukan karena
            Play Protect memblokir.
          </p>
        </div>
        <div>
          <h3>Ini bukan malware</h3>
          <p class="muted">
            Kode sumber terbuka di GitHub. Mulai {APP.version} APK ditandatangani
            keystore resmi XyVerse (bukan key debug) dan kode Java/Kotlin di-minify R8.
            Peringatan Android "sumber tidak dikenal" muncul untuk semua aplikasi
            di luar Play Store — itu pengingat sideload, bukan vonis berbahaya.
          </p>
        </div>
        <div>
          <h3>Cara cek sendiri</h3>
          <p class="muted">
            Unduh hanya dari <code>{APP.downloadUrl.replace('https://', '')}</code>.
            Bandingkan SHA-256 di kartu unduhan. APK 3.2.2 lolos ClamAV (bersih)
            dan ditandatangani CN=XyVerse. Unggah ke VirusTotal kalau mau cek
            mesin lain. Jangan pasang berkas yang dikirim orang lewat chat.
          </p>
        </div>
        <div>
          <h3>Izin yang diminta</h3>
          <p class="muted">
            Internet (generate ke Groq), tampil di atas aplikasi lain (gelembung overlay),
            layanan latar (biar overlay tidak ditutup), dan notifikasi.
            Tidak ada izin SMS, kontak, atau lokasi.
          </p>
        </div>
      </div>
      <p class="muted small" style="margin-top:14px">
        Pertanyaan lain ada di <a href="/faq">FAQ</a>.
        Source: <a href={APP.githubUrl} target="_blank" rel="noopener">github.com/xykalnotkel/groq-studio</a>.
      </p>
    </section>
  </main>
</Base>

<style>
  .kicker {
    font-size: 11px; font-weight: 800; letter-spacing: 1.5px;
    text-transform: uppercase; color: var(--cyan); margin-bottom: 8px;
  }
  h1 { font-size: 32px; font-weight: 800; letter-spacing: -.7px; line-height: 1.15; }
  h2 { font-size: 18px; font-weight: 800; margin-bottom: 4px; }
  h3 { font-size: 14.5px; font-weight: 800; margin-bottom: 6px; }
  code { background: rgba(124,92,255,.16); padding: 2px 6px; border-radius: 6px; font-size: 13px; }
  a { color: #b9a6ff; }
  .dl-page {
    display: grid;
    grid-template-columns: 1.2fr .8fr;
    gap: 18px;
    padding: 36px 0 20px;
  }
  .dl-wide { grid-column: 1 / -1; }
  .safe-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 12px; }
  .safe-grid p { font-size: 13.8px; line-height: 1.65; }
  @media (max-width: 900px) {
    .dl-page { grid-template-columns: 1fr; }
    .safe-grid { grid-template-columns: 1fr; }
  }
</style>
