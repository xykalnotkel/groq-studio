---
import Base from '../layouts/Base.astro';
import { APP, MODES } from '../data/app.js';

const highlights = [
  { icon: '⚡', title: 'Streaming real-time', text: 'Hasil muncul kata demi kata — nggak perlu menunggu selesai.' },
  { icon: '🎛️', title: 'Hasil bisa diatur', text: 'Bahasa, gaya, panjang, dan tingkat kreativitas bebas dipilih.' },
  { icon: '📚', title: 'Riwayat otomatis', text: 'Semua hasil tersimpan di perangkat, bisa dicari & dibagikan.' },
  { icon: '🎨', title: 'UI morphing', text: 'Latar bergerak halus, tombol berubah bentuk, transisi menyatu.' },
  { icon: '🔒', title: 'Privat', text: 'API key hanya di perangkatmu, dikirim langsung ke Groq.' },
  { icon: '📱', title: 'Android + Web', text: 'Satu akun, bisa dipakai di HP Android maupun browser.' },
];

const shots = [
  { src: '/shots/01_home.png', alt: 'Halaman utama XyStudio AI' },
  { src: '/shots/02_hasil.png', alt: 'Contoh artikel yang dihasilkan' },
  { src: '/shots/03_riwayat.png', alt: 'Halaman riwayat' },
  { src: '/shots/05_mode.png', alt: 'Daftar mode generate' },
];
---

<Base>
  <header class="nav">
    <div class="wrap nav-inner">
      <a class="brand" href="/">
        <img src="/logo.png" alt="" width="38" height="38" />
        <span>{APP.name}</span>
      </a>
      <nav>
        <a href="/app">Web App</a>
        <a href="/about">Tentang</a>
        <a class="btn sm" href="/app">Mulai Nulis</a>
      </nav>
    </div>
  </header>

  <main class="wrap">
    <!-- HERO -->
    <section class="hero">
      <div class="hero-copy">
        <span class="badge">✨ {MODES.length} mode generate · Ditenagai Groq</span>
        <h1>
          Tulis <span class="grad">judul, artikel, caption</span><br />
          cuma dari satu kalimat.
        </h1>
        <p class="muted lead">
          {APP.name} mengubah ide setengah jadi tulisan jadi: artikel lengkap,
          deskripsi produk, naskah video, prompt gambar, sampai balasan chat
          pembeli. Cepat, gratis, dan tampilannya enak dipakai.
        </p>
        <div class="cta">
          <a class="btn" href="/app">🚀 Buka Web App</a>
          <a class="btn ghost" href={APP.releasesUrl} target="_blank" rel="noopener">
            📱 Download APK
          </a>
        </div>
        <div class="hero-meta muted small">
          Tanpa daftar akun · API key Groq gratis · Android 7+ &amp; browser modern
        </div>
      </div>
      <div class="hero-art">
        <img src="/shots/01_home.png" alt="Tampilan aplikasi XyStudio AI" />
      </div>
    </section>

    <!-- HIGHLIGHTS -->
    <section class="section">
      <h2 class="section-title">Kenapa pakai {APP.name}?</h2>
      <div class="grid-3">
        {highlights.map((h) => (
          <div class="card feat">
            <div class="feat-icon">{h.icon}</div>
            <h3>{h.title}</h3>
            <p class="muted">{h.text}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- MODES -->
    <section class="section">
      <h2 class="section-title">{MODES.length} mode siap pakai</h2>
      <div class="modes">
        {MODES.map((m) => (
          <div class="mode">
            <strong>{m.label}</strong>
            <span class="muted small">{m.hint}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- SCREENSHOTS -->
    <section class="section">
      <h2 class="section-title">Tampilannya</h2>
      <div class="shots">
        {shots.map((s) => (
          <img src={s.src} alt={s.alt} loading="lazy" />
        ))}
      </div>
    </section>

    <!-- WA CTA -->
    <section class="section wa">
      <div class="wa-inner">
        <img src="/wa-channel.png" alt="" class="wa-art" />
        <div class="wa-copy">
          <h2>Gabung {APP.waChannelName}</h2>
          <p class="muted">
            Update fitur, template prompt, dan tips AI langsung ke WhatsApp kamu.
          </p>
          <a class="btn green" href={APP.waChannelUrl} target="_blank" rel="noopener">
            Gabung Sekarang
          </a>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .nav { padding: 18px 0; position: sticky; top: 0; z-index: 20;
         background: rgba(10,10,20,.72); backdrop-filter: blur(12px);
         border-bottom: 1px solid var(--line); }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .brand { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 17px; }
  .brand img { border-radius: 10px; }
  .nav nav { display: flex; align-items: center; gap: 20px; font-size: 14px; font-weight: 600; }
  .nav nav a:not(.btn) { color: var(--muted); }
  .nav nav a:not(.btn):hover { color: var(--text); }

  .hero { display: grid; grid-template-columns: 1.05fr .95fr; gap: 44px;
          align-items: center; padding: 58px 0 30px; }
  .badge { display: inline-block; padding: 6px 14px; border-radius: 999px;
           border: 1px solid rgba(124,92,255,.3); background: rgba(124,92,255,.1);
           color: #c9bcff; font-size: 12.5px; font-weight: 700; margin-bottom: 18px; }
  h1 { font-size: 46px; line-height: 1.12; letter-spacing: -1.4px; font-weight: 800; }
  .grad { background: linear-gradient(120deg, var(--violet), var(--cyan));
          -webkit-background-clip: text; background-clip: text; color: transparent; }
  .lead { font-size: 16.5px; margin: 18px 0 26px; max-width: 520px; }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; }
  .hero-meta { margin-top: 16px; }
  .hero-art { display: grid; place-items: center; }
  .hero-art img { width: 100%; max-width: 300px; border-radius: 28px;
                  border: 1px solid var(--line);
                  box-shadow: 0 40px 90px rgba(124,92,255,.28); }

  .section { padding: 46px 0; }
  .section-title { font-size: 28px; font-weight: 800; letter-spacing: -.7px; margin-bottom: 22px; }
  .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .feat h3 { font-size: 16px; margin-bottom: 6px; }
  .feat p { font-size: 13.6px; line-height: 1.6; }
  .feat-icon { font-size: 22px; margin-bottom: 10px; }

  .modes { display: grid; grid-template-columns: repeat(4, 1fr); gap: 11px; }
  .mode { padding: 14px; border-radius: 16px; border: 1px solid var(--line);
          background: rgba(20,20,36,.6); display: flex; flex-direction: column; gap: 3px;
          transition: transform .2s, border-color .2s; }
  .mode:hover { transform: translateY(-3px); border-color: var(--violet); }
  .mode strong { font-size: 13.6px; }

  .shots { display: flex; gap: 14px; overflow-x: auto; padding-bottom: 10px; }
  .shots img { height: 420px; border-radius: 20px; border: 1px solid var(--line); flex: none; }

  .wa-inner { display: grid; grid-template-columns: 1.1fr 1fr; gap: 26px;
              align-items: center; overflow: hidden;
              border: 1px solid var(--line); border-radius: 26px;
              background: rgba(20,20,36,.7); }
  .wa-art { width: 100%; height: 260px; object-fit: cover; }
  .wa-copy { padding: 26px 26px 26px 0; }
  .wa-copy h2 { font-size: 24px; font-weight: 800; margin-bottom: 8px; letter-spacing: -.5px; }
  .wa-copy p { margin-bottom: 18px; font-size: 14.5px; }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; padding-top: 34px; }
    h1 { font-size: 34px; }
    .hero-art { order: -1; }
    .hero-art img { max-width: 210px; }
    .grid-3 { grid-template-columns: repeat(2, 1fr); }
    .modes { grid-template-columns: repeat(2, 1fr); }
    .wa-inner { grid-template-columns: 1fr; }
    .wa-copy { padding: 20px; }
    .shots img { height: 340px; }
  }
</style>
