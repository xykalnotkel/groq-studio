---
import Base from '../layouts/Base.astro';
import { APP, MODES } from '../data/app.js';

const highlights = [
  { color: '#7C5CFF', title: 'Model Auto (muter)', text: 'Model dirotasi tiap generate dan otomatis pindah saat ada yang sibuk atau error.' },
  { color: '#22D3EE', title: 'Hasil bisa disunting', text: 'Teks muncul utuh, lalu bisa langsung disunting dan disukai. Riwayat tersimpan di perangkatmu.' },
  { color: '#4ADE80', title: 'Riset Web bawaan', text: 'Aplikasi mencari dan membaca sumber sendiri, lalu merangkumnya. Ada juga mode ringkas URL.' },
  { color: '#F472B6', title: '12 gaya menulis', text: 'Natural, padat-tajam, bercerita, elegan, puitis, dan banyak lagi — tanpa emoji di hasil.' },
  { color: '#FBBF24', title: 'Statistik pemakaian', text: 'Total generate, kata, karakter, mode favorit, streak harian, dan grafik 7 hari.' },
  { color: '#FB7185', title: 'Android + Web', text: 'Satu pengalaman di HP Android dan browser. Ada floating overlay, PiP, dan widget beranda; API key hanya tersimpan di perangkatmu.' },
];

const shots = [
  { webp: '/shots/01_home.webp', png: '/shots/01_home.png', alt: 'Halaman utama XyStudio AI' },
  { webp: '/shots/02_hasil.webp', png: '/shots/02_hasil.png', alt: 'Contoh artikel yang dihasilkan' },
  { webp: '/shots/03_riwayat.webp', png: '/shots/03_riwayat.png', alt: 'Halaman riwayat' },
  { webp: '/shots/05_mode.webp', png: '/shots/05_mode.png', alt: 'Daftar mode generate' },
];
---

<Base current="home">
  <main class="wrap">
    <section class="hero">
      <div class="hero-copy">
        <span class="badge">{MODES.length} mode generate · Ditenagai Groq</span>
        <h1>
          Tulis <span class="grad">judul, artikel, caption</span><br />
          cuma dari satu kalimat.
        </h1>
        <p class="muted lead">
          {APP.name} mengubah ide setengah jadi tulisan jadi: artikel lengkap,
          deskripsi produk, naskah video, prompt gambar dan video, riset web,
          sampai balasan chat pembeli. Cepat, gratis, dan tampilannya enak dipakai.
        </p>
        <div class="cta">
          <a class="btn" href="/app">Buka Web App</a>
          <a class="btn ghost" href="/download">Download APK</a>
        </div>
        <div class="hero-meta muted small">
          Tanpa daftar akun · API key Groq gratis · Android 7+ dan browser modern.
          APK resmi di dl.xystudio.my.id. Belum di Play Store karena biaya daftar
          developer belum ada — bukan malware.
        </div>
      </div>
      <div class="hero-art">
        <div class="phone-shot hero-phone">
          <picture>
            <source srcset="/shots/01_home.webp" type="image/webp" />
            <img src="/shots/01_home.png" alt="Tampilan aplikasi XyStudio AI" width="540" height="960" decoding="async" />
          </picture>
        </div>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">Kenapa pakai {APP.name}?</h2>
      <div class="grid-3">
        {highlights.map((h) => (
          <div class="card feat">
            <div class="feat-icon"><span class="feat-dot" style={`background:${h.color}`}></span></div>
            <h3>{h.title}</h3>
            <p class="muted">{h.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">{MODES.length} mode siap pakai</h2>
      <div class="modes">
        {MODES.map((m) => (
          <div class="mode">
            <strong>{m.label}</strong>
            <span class="muted small">{m.hint}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">Tampilannya</h2>
      <div class="shots">
        {shots.map((s) => (
          <div class="phone-shot">
            <picture>
              <source srcset={s.webp} type="image/webp" />
              <img src={s.png} alt={s.alt} width="540" height="960" loading="lazy" decoding="async" />
            </picture>
          </div>
        ))}
      </div>
    </section>

    <section class="section wa">
      <div class="wa-inner">
        <picture>
          <source srcset="/wa_popup_43.webp" type="image/webp" />
          <img src="/wa_popup_43.png" alt="" class="wa-art" width="800" height="597" loading="lazy" decoding="async" />
        </picture>
        <div class="wa-copy">
          <h2>Gabung {APP.waChannelName}</h2>
          <p class="muted">
            Update fitur, template prompt, dan tips AI langsung ke WhatsApp kamu.
          </p>
          <a class="btn green" href={APP.waChannelUrl} target="_blank" rel="noopener">
            Gabung Sekarang
          </a>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1.05fr .95fr; gap: 44px;
          align-items: center; padding: 58px 0 30px; min-width: 0; }
  .hero-copy, .hero-art { min-width: 0; }
  .badge { display: inline-block; padding: 6px 14px; border-radius: 999px;
           border: 1px solid rgba(124,92,255,.3); background: rgba(124,92,255,.1);
           color: #c9bcff; font-size: 12.5px; font-weight: 700; margin-bottom: 18px; }
  h1 { font-size: clamp(26px, 8vw, 46px); line-height: 1.12; letter-spacing: -1.4px; font-weight: 800; }
  .grad { background: linear-gradient(120deg, var(--violet), var(--cyan));
          -webkit-background-clip: text; background-clip: text; color: transparent; }
  .lead { font-size: 16.5px; margin: 18px 0 26px; max-width: 520px; }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; }
  .hero-meta { margin-top: 16px; }
  .hero-art { display: grid; place-items: center; }
  .hero-phone { width: min(280px, 70vw); box-shadow: 0 40px 90px rgba(124,92,255,.28); }

  .section { padding: 46px 0; min-width: 0; overflow-x: clip; }
  .section-title { font-size: 28px; font-weight: 800; letter-spacing: -.7px; margin-bottom: 22px; }
  .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .feat h3 { font-size: 16px; margin-bottom: 6px; }
  .feat p { font-size: 13.6px; line-height: 1.6; }
  .feat-icon { margin-bottom: 10px; }
  .feat-dot { display: inline-block; width: 18px; height: 18px; border-radius: 6px;
              box-shadow: 0 0 16px rgba(124,92,255,.4); }

  .modes { display: grid; grid-template-columns: repeat(4, 1fr); gap: 11px; }
  .mode { padding: 14px; border-radius: 16px; border: 1px solid var(--line);
          background: rgba(20,20,36,.6); display: flex; flex-direction: column; gap: 3px; }
  .mode:hover { border-color: var(--violet); }
  .mode strong { font-size: 13.6px; }

  .shots { padding-bottom: 10px; }

  .wa-inner { display: grid; grid-template-columns: 1.1fr 1fr; gap: 26px;
              align-items: center; overflow: hidden;
              border: 1px solid var(--line); border-radius: 26px;
              background: rgba(20,20,36,.7); }
  .wa-inner picture { display: block; min-width: 0; }
  .wa-art { width: 100%; height: 240px; object-fit: cover; object-position: center; display: block; }
  .wa-copy { padding: 26px 26px 26px 0; }
  .wa-copy h2 { font-size: 24px; font-weight: 800; margin-bottom: 8px; letter-spacing: -.5px; }
  .wa-copy p { margin-bottom: 18px; font-size: 14.5px; }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; padding-top: 28px; gap: 22px; }
    h1 { font-size: 30px; letter-spacing: -0.8px; }
    .hero-art { order: -1; }
    .hero-phone { width: min(200px, 52vw); }
    .grid-3 { grid-template-columns: 1fr; }
    .modes { grid-template-columns: repeat(2, 1fr); }
    .wa-inner { grid-template-columns: 1fr; }
    .wa-copy { padding: 20px; }
    .wa-art { height: 160px; }
    .section-title { font-size: 22px; }
  }
  @media (max-width: 480px) {
    .modes { grid-template-columns: 1fr; }
    .cta { flex-direction: column; }
    .cta .btn { width: 100%; }
  }
</style>
