---
import Base from '../layouts/Base.astro';
import { APP, MODES, LANGUAGES, TONES, LENGTHS, MODELS, AUTO_MODEL } from '../data/app.js';

// Key bawaan (opsional) yang disuntikkan saat build:
//   PUBLIC_GROQ_API_KEY=gsk_xxx npm run build
// Ingat: apa pun yang diawali PUBLIC_ akan terlihat di bundle browser.
const BUILD_KEY: string = import.meta.env.PUBLIC_GROQ_API_KEY ?? '';
---

<Base current="app" title={`${APP.name} — Web App`} description="Bikin judul, artikel, caption, riset web, prompt video, dan 20 mode lain langsung dari browser.">
  <main class="wrap app-grid">
    <!-- KIRI: formulir -->
    <section class="card pane">
      <div class="pane-top">
        <p class="label">Mau dibuatin apa?</p>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <button class="btn sm ghost" id="btn-acak" type="button">Acak</button>
          <button class="btn sm ghost" id="btn-settings" type="button">Setelan</button>
        </div>
      </div>
      <div class="modes" id="modes">
        {MODES.map((m, i) => (
          <button class={`chip mode-chip${i === 0 ? ' active' : ''}`} data-mode={m.id} title={m.hint}>
            {m.label}
          </button>
        ))}
      </div>

      <div id="engine-row" hidden style="margin-top:14px">
        <p class="label" style="margin-bottom:8px">Engine target</p>
        <div class="engines" id="engines"></div>
      </div>

      <p class="label" style="margin-top:20px" id="input-label">Ceritakan sebentar</p>
      <textarea id="brief" rows="5" placeholder="Contoh: aplikasi pencatat keuangan untuk anak kos yang bisa scan struk"></textarea>
      <textarea id="extra" rows="2" style="margin-top:10px" placeholder="Tambahan: target audiens, kata kunci, catatan (opsional)"></textarea>

      <div class="opts">
        <label>
          <span class="label">Bahasa</span>
          <select id="lang">
            {LANGUAGES.map((l) => <option value={l.code}>{l.label}</option>)}
          </select>
        </label>
        <label>
          <span class="label">Gaya</span>
          <select id="tone">
            {TONES.map((t) => <option value={t.id}>{t.label}</option>)}
          </select>
        </label>
        <label>
          <span class="label">Panjang</span>
          <select id="length">
            {LENGTHS.map((l) => <option value={l.id} selected={l.id === 'sedang'}>{l.label}</option>)}
          </select>
        </label>
        <label>
          <span class="label">Model</span>
          <select id="model">
            <option value="auto" selected>{AUTO_MODEL.label}</option>
            {MODELS.map((m) => <option value={m.id}>{m.label}</option>)}
          </select>
        </label>
      </div>

      <div class="opts">
        <label>
          <span class="label">Kreativitas: <b id="temp-val">0.8</b></span>
          <input type="range" id="temp" min="0" max="1.5" step="0.1" value="0.8" />
        </label>
      </div>

      <button class="btn" id="btn-generate" style="width:100%;margin-top:18px">
        Buat Judul
      </button>
      <p class="muted small" id="status" style="margin-top:10px"></p>
    </section>

    <!-- KANAN: hasil -->
    <section class="card pane result-pane">
      <div class="result-head">
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
          <p class="label" style="margin:0">Hasil</p>
          <span class="model-badge" id="model-badge" hidden></span>
        </div>
        <div class="result-actions">
          <button class="chip" id="btn-edit" disabled>Sunting</button>
          <button class="chip" id="btn-like" disabled>Suka</button>
          <button class="chip" id="btn-listen" disabled>Dengarkan</button>
          <button class="chip" id="btn-copy" disabled>Salin</button>
          <button class="chip" id="btn-clear">Bersihkan</button>
        </div>
      </div>
      <div id="tts-panel" class="tts-panel" hidden>
        <span id="tts-status">Suara siap</span>
        <span class="tts-controls">
          <button class="chip sm-chip" id="tts-play">Putar</button>
          <button class="chip sm-chip" id="tts-pause" disabled>Jeda</button>
          <button class="chip sm-chip" id="tts-stop" disabled>Berhenti</button>
        </span>
        <span class="tts-slider">Nada <input type="range" id="tts-pitch" min="0.5" max="2" step="0.1" value="1" /></span>
        <span class="tts-slider">Kecepatan <input type="range" id="tts-rate" min="0.5" max="2" step="0.1" value="1" /></span>
      </div>
      <div id="result" class="md result-box">
        <p class="muted">
          Belum ada hasil. Pilih mode di kiri, tulis idemu, lalu tekan tombolnya.
          {BUILD_KEY ? 'Key Groq bawaan sudah terpasang.' : 'Kalau belum punya API key Groq, buka Setelan dulu ya — gratis.'}
        </p>
      </div>
      <div id="edit-box" class="edit-box" hidden>
        <p class="label">Sunting hasil</p>
        <textarea id="edit-text" rows="10"></textarea>
        <div class="edit-actions">
          <button class="btn sm" id="edit-save">Simpan</button>
          <button class="chip" id="edit-cancel">Batal</button>
        </div>
      </div>
      <div class="history">
        <p class="label">Riwayat (tersimpan di browser ini)</p>
        <div id="history-list" class="hist-list">
          <p class="muted small">Belum ada riwayat.</p>
        </div>
      </div>
    </section>
  </main>

  <!-- Panel setelan -->
  <div class="sheet" id="sheet" hidden>
    <div class="sheet-card">
      <div class="sheet-head">
        <strong>Setelan</strong>
        <button class="chip" id="btn-close-sheet">Tutup</button>
      </div>
      <label class="field">
        <span class="label">API key Groq</span>
        <input
          type="password"
          id="apikey"
          placeholder="gsk_xxxxxxxxxxxxxxxxxxxx"
          value={BUILD_KEY}
          autocomplete="off"
        />
      </label>
      <p class="muted small">
        Key disimpan hanya di browser ini (localStorage) dan dikirim langsung ke
        api.groq.com. Ambil gratis di
        <a href={APP.keysUrl} target="_blank" rel="noopener" style="color:var(--cyan)">console.groq.com/keys</a>.
        {BUILD_KEY
          ? 'Aplikasi ini sudah menyertakan key bawaan — kamu bisa pakai itu atau ganti dengan punyamu.'
          : ''}
      </p>
      <div class="sheet-actions">
        <button class="btn sm" id="btn-save-key">Simpan key</button>
        <button class="btn sm ghost" id="btn-test-key">Tes koneksi</button>
      </div>
      <p class="muted small" id="key-status" style="margin-top:10px"></p>

      <hr style="margin:18px 0;border:0;border-top:1px solid var(--line)" />

      <div class="stats-box">
        <div class="sheet-head" style="margin-bottom:10px">
          <strong>Statistik pemakaian</strong>
          <button class="chip" id="btn-reset-stats">Reset</button>
        </div>
        <div class="stats-grid">
          <div><b id="st-total">0</b><span>total generate</span></div>
          <div><b id="st-words">0</b><span>total kata</span></div>
          <div><b id="st-chars">0</b><span>total karakter</span></div>
          <div><b id="st-streak">0</b><span>streak harian</span></div>
          <div><b id="st-tok">0</b><span>token Groq</span></div>
        </div>
        <p class="muted small" id="st-fav" style="margin-top:8px">Mode favorit: belum ada</p>
        <canvas id="st-chart" width="380" height="90" style="width:100%;margin-top:8px"></canvas>
      </div>

      <hr style="margin:18px 0;border:0;border-top:1px solid var(--line)" />
      <p class="muted small">
        Butuh bantuan?
        <a href="#" data-bug-open style="color:var(--pink)">Laporkan bug</a>
        ·
        <a href={APP.waChannelUrl} target="_blank" rel="noopener" style="color:var(--green)">Gabung saluran WA</a>
      </p>
      <p class="credit-line">
        <img src="/xyverse_icon_white.png" alt="" width="14" height="14" style="vertical-align:-2px;margin-right:6px" />
        {APP.credit}
      </p>
    </div>
  </div>

<script define:vars={{ MODES, BUILD_KEY, APP, MODELS, AUTO_MODEL, TONES, LENGTHS }}>
  const $ = (id) => document.getElementById(id);
  const els = {
    modes: $('modes'), enginesRow: $('engine-row'), engines: $('engines'),
    brief: $('brief'), extra: $('extra'), inputLabel: $('input-label'),
    lang: $('lang'), tone: $('tone'), length: $('length'), model: $('model'),
    temp: $('temp'), tempVal: $('temp-val'),
    generate: $('btn-generate'), status: $('status'), result: $('result'),
    badge: $('model-badge'), listen: $('btn-listen'), copy: $('btn-copy'), clear: $('btn-clear'),
    edit: $('btn-edit'), like: $('btn-like'),
    editBox: $('edit-box'), editText: $('edit-text'), editSave: $('edit-save'), editCancel: $('edit-cancel'),
    ttsPanel: $('tts-panel'), ttsStatus: $('tts-status'),
    ttsPlay: $('tts-play'), ttsPause: $('tts-pause'), ttsStop: $('tts-stop'),
    ttsPitch: $('tts-pitch'), ttsRate: $('tts-rate'),
    history: $('history-list'),
    settings: $('btn-settings'), sheet: $('sheet'), closeSheet: $('btn-close-sheet'),
    apikey: $('apikey'), saveKey: $('btn-save-key'), testKey: $('btn-test-key'),
    keyStatus: $('key-status'), resetStats: $('btn-reset-stats'),
  };

  const KEY_STORE = 'xystudio:apikey';
  const PREF_STORE = 'xystudio:prefs';
  const HIST_STORE = 'xystudio:history';
  const STAT_STORE = 'xystudio:stats';
  const ROT_STORE = 'xystudio:autoIndex';
  const GROQ_URL = 'https://api.groq.com/openai/v1/chat/completions';
  const GROQ_TTS = 'https://api.groq.com/openai/v1/audio/speech';

  let mode = MODES[0];
  let engine = (mode.engines || [null])[0] || null;
  let controller = null;
  let busy = false;
  let fullText = '';
  let answeredBy = null;
  let currentId = null; // id riwayat dari hasil yang sedang tampil

  // ── util ──────────────────────────────────────────────────────────
  const EMOJI_RE = /[\u{1F000}-\u{1FAFF}\u{1F1E6}-\u{1F1FF}\u2600-\u27BF\u2300-\u23FF\u2B00-\u2BFF\uFE00-\uFE0F\u200D\u20E3\u2190-\u21FF\u2900-\u297F\u00A9\u00AE\u2122]/gu;
  const stripEmoji = (s) => s.replace(EMOJI_RE, '').replace(/[ \t]{2,}/g, ' ').replace(/\n[ \t]*\n[ \t]*(\n[ \t]*)+/g, '\n\n').trimEnd();
  function keepText(src) {
    try {
      const cleaned = stripEmoji(src);
      return cleaned.trim() ? cleaned : src;
    } catch {
      return src;
    }
  }
  const countWords = (s) => (s.trim() ? s.trim().split(/\s+/).length : 0);
  const dayKey = (d = new Date()) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;

  function escapeHtml(s) {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }

  function renderMd(src) {
    let html = escapeHtml(src);
    html = html.replace(/```([\s\S]*?)```/g, (_, c) => `<pre><code>${c}</code></pre>`);
    html = html.replace(/^### (.*)$/gm, '<h3>$1</h3>');
    html = html.replace(/^## (.*)$/gm, '<h2>$1</h2>');
    html = html.replace(/^# (.*)$/gm, '<h1>$1</h1>');
    html = html.replace(/^&gt; (.*)$/gm, '<blockquote>$1</blockquote>');
    html = html.replace(/^---$/gm, '<hr/>');
    html = html.replace(/^\s*[-*] (.*)$/gm, '<li>$1</li>');
    html = html.replace(/((?:<li>.*<\/li>\n?)+)/g, '<ul>$1</ul>');
    html = html.replace(/^\s*(\d+)\. (.*)$/gm, '<li>$1. $2</li>');
    html = html.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
    html = html.replace(/`([^`]+)`/g, '<code>$1</code>');
    html = html.replace(/\n\n/g, '</p><p>');
    return '<p>' + html + '</p>';
  }

  // ── preferensi ──────────────────────────────────────────────────
  function loadPrefs() { try { return JSON.parse(localStorage.getItem(PREF_STORE) || '{}'); } catch { return {}; } }
  function savePrefs(p) { try { localStorage.setItem(PREF_STORE, JSON.stringify(p)); } catch {} }
  const prefs = loadPrefs();
  if (prefs.lang) els.lang.value = prefs.lang;
  if (prefs.tone) els.tone.value = prefs.tone;
  if (prefs.length) els.length.value = prefs.length;
  if (prefs.model) els.model.value = prefs.model;
  if (prefs.temp) { els.temp.value = prefs.temp; els.tempVal.textContent = prefs.temp; }
  if (prefs.mode) { const m = MODES.find((x) => x.id === prefs.mode); if (m) { mode = m; engine = (m.engines || [null])[0] || null; } }
  try { const savedKey = localStorage.getItem(KEY_STORE); if (savedKey) els.apikey.value = savedKey; } catch {}

  function syncPrefs() {
    savePrefs({
      lang: els.lang.value, tone: els.tone.value, length: els.length.value,
      model: els.model.value, temp: els.temp.value, mode: mode.id,
    });
  }
  ['lang', 'tone', 'length', 'model'].forEach((k) => els[k].addEventListener('change', syncPrefs));
  els.temp.addEventListener('input', () => { els.tempVal.textContent = els.temp.value; syncPrefs(); });

  function syncModeUI() {
    els.modes.querySelectorAll('.mode-chip').forEach((c) => {
      c.classList.toggle('active', c.dataset.mode === mode.id);
    });
    els.generate.textContent = busy ? 'Hentikan' : `Buat ${mode.label}`;
    els.inputLabel.textContent = mode.inputLabel || 'Ceritakan sebentar';
    els.brief.placeholder = mode.placeholder || '';
    els.extra.style.display = mode.kind === 'urlSummary' ? 'none' : '';
    els.extra.placeholder = mode.engines
      ? 'Tambahan: gaya visual, negative prompt, catatan (opsional)'
      : 'Tambahan: target audiens, kata kunci, catatan (opsional)';
    // engine
    if (mode.engines && mode.engines.length) {
      els.enginesRow.hidden = false;
      els.engines.innerHTML = mode.engines.map((e) =>
        `<button class="chip engine-chip${e === engine ? ' active' : ''}" data-engine="${e}">${e}</button>`).join('');
    } else {
      els.enginesRow.hidden = true;
      els.engines.innerHTML = '';
    }
  }

  $('btn-acak')?.addEventListener('click', () => {
    const pick = MODES[Math.floor(Math.random() * MODES.length)];
    mode = pick;
    engine = (mode.engines || [null])[0] || null;
    syncModeUI(); syncPrefs();
    els.status.textContent = 'Mode acak: ' + mode.label;
  });

  els.modes.addEventListener('click', (e) => {
    const btn = e.target.closest('.mode-chip');
    if (!btn) return;
    mode = MODES.find((m) => m.id === btn.dataset.mode) || mode;
    engine = (mode.engines || [null])[0] || null;
    syncModeUI(); syncPrefs();
  });
  els.engines.addEventListener('click', (e) => {
    const btn = e.target.closest('.engine-chip');
    if (!btn) return;
    engine = btn.dataset.engine;
    syncModeUI();
  });

  // ── setelan ─────────────────────────────────────────────────────
  els.settings.addEventListener('click', () => { els.sheet.hidden = false; renderStats(); });
  els.closeSheet.addEventListener('click', () => { els.sheet.hidden = true; });
  els.sheet.addEventListener('click', (e) => { if (e.target === els.sheet) els.sheet.hidden = true; });

  els.saveKey.addEventListener('click', () => {
    const v = els.apikey.value.trim();
    try { v ? localStorage.setItem(KEY_STORE, v) : localStorage.removeItem(KEY_STORE); } catch {}
    els.keyStatus.textContent = v ? 'API key tersimpan di browser ini.' : 'API key dihapus.';
  });

  els.testKey.addEventListener('click', async () => {
    const key = currentKey();
    if (!key) { els.keyStatus.innerHTML = '<span class="xy-err-inline">Isi API key dulu ya.</span>'; return; }
    els.keyStatus.textContent = 'Menguji koneksi…';
    try {
      const r = await fetch('https://api.groq.com/openai/v1/models', {
        headers: { Authorization: `Bearer ${key}` },
      });
      if (!r.ok) { const e = new Error('HTTP ' + r.status); e.status = r.status; throw e; }
      const data = await r.json();
      els.keyStatus.textContent = `Terhubung! ${(data.data || []).length} model tersedia.`;
      if (window.xyToast) window.xyToast('Koneksi Groq berhasil.', 'ok');
    } catch (err) {
      const friendly = window.xyFriendlyError ? window.xyFriendlyError(err) : 'Gagal terhubung. Cek key & internet kamu.';
      els.keyStatus.innerHTML = `<span class="xy-err-inline">${friendly}</span>`;
    }
  });

  function currentKey() {
    const typed = els.apikey.value.trim();
    if (typed) return typed;
    try { return localStorage.getItem(KEY_STORE) || BUILD_KEY || ''; } catch { return BUILD_KEY || ''; }
  }

  // ── statistik (localStorage) ────────────────────────────────────
  function loadStats() {
    try { return JSON.parse(localStorage.getItem(STAT_STORE) || '{"t":0,"w":0,"c":0,"modes":{},"days":{}}'); }
    catch { return { t: 0, w: 0, c: 0, modes: {}, days: {} }; }
  }
  function recordStats(text) {
    const s = loadStats();
    s.t += 1; s.w += countWords(text); s.c += text.length;
    s.tok = (s.tok || 0) + Math.max(1, Math.ceil(text.length / 4));
    s.modes[mode.id] = (s.modes[mode.id] || 0) + 1;
    const k = dayKey(); s.days[k] = (s.days[k] || 0) + 1;
    try { localStorage.setItem(STAT_STORE, JSON.stringify(s)); } catch {}
    try {
      const p = JSON.parse(localStorage.getItem('xystudio:profile') || 'null');
      if (p && p.email && p.pin) {
        fetch('/api/leaderboard', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'sync', email: p.email, name: p.name, pin: p.pin,
            tokens: s.tok || 0, generates: s.t || 0,
          }),
        }).catch(() => {});
      }
    } catch {}
  }
  function statsStreak(s) {
    let cursor = new Date(); let streak = 0;
    if (!s.days[dayKey(cursor)]) { cursor.setDate(cursor.getDate() - 1); if (!s.days[dayKey(cursor)]) return 0; }
    while (s.days[dayKey(cursor)]) { streak += 1; cursor.setDate(cursor.getDate() - 1); }
    return streak;
  }
  function renderStats() {
    const s = loadStats();
    $('st-total').textContent = s.t;
    $('st-words').textContent = s.w >= 1000 ? (s.w / 1000).toFixed(1) + ' rb' : s.w;
    $('st-chars').textContent = s.c >= 1000 ? (s.c / 1000).toFixed(1) + ' rb' : s.c;
    $('st-streak').textContent = statsStreak(s);
    const tok = s.tok || 0;
    $('st-tok').textContent = tok >= 1000 ? (tok / 1000).toFixed(1) + ' rb' : tok;
    const fav = Object.entries(s.modes).sort((a, b) => b[1] - a[1])[0];
    const favLabel = fav ? (MODES.find((m) => m.id === fav[0]) || { label: fav[0] }).label : 'belum ada';
    $('st-fav').textContent = `Mode favorit: ${favLabel}${fav ? ` (${fav[1]}x)` : ''}`;
    // grafik 7 hari
    const cv = $('st-chart'); const ctx = cv.getContext('2d');
    ctx.clearRect(0, 0, cv.width, cv.height);
    const days = [];
    for (let i = 6; i >= 0; i--) { const d = new Date(); d.setDate(d.getDate() - i); days.push(d); }
    const max = Math.max(1, ...days.map((d) => s.days[dayKey(d)] || 0));
    const slot = cv.width / 7;
    days.forEach((d, i) => {
      const v = s.days[dayKey(d)] || 0;
      const h = v === 0 ? 3 : (v / max) * 58;
      const x = slot * i + slot * 0.25;
      ctx.fillStyle = v ? (i === 6 ? '#7c5cff' : 'rgba(124,92,255,.55)') : 'rgba(255,255,255,.12)';
      ctx.beginPath(); ctx.roundRect(x, 62 - h, slot * 0.5, h, 4); ctx.fill();
      if (v) { ctx.fillStyle = '#a78bfa'; ctx.font = '700 10px sans-serif'; ctx.textAlign = 'center'; ctx.fillText(v, x + slot * 0.25, 58 - h); }
      ctx.fillStyle = 'rgba(255,255,255,.45)'; ctx.font = '600 10px sans-serif'; ctx.textAlign = 'center';
      ctx.fillText(['Min', 'Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab'][d.getDay()], x + slot * 0.25, 78);
    });
  }
  els.resetStats.addEventListener('click', async () => {
    const ok = window.xyConfirm
      ? await window.xyConfirm({
          title: 'Reset statistik?',
          body: 'Angka pemakaian di browser ini dihapus. Riwayat hasil tidak ikut terhapus.',
          ok: 'Reset',
          cancel: 'Batal',
          danger: true,
        })
      : true;
    if (!ok) return;
    try { localStorage.removeItem(STAT_STORE); } catch {}
    renderStats();
    if (window.xyToast) window.xyToast('Statistik direset.', 'ok');
  });

  // ── riset web: cari sumber lalu dirangkum ───────────────────────
  async function fetchViaProxy(url) {
    // langsung dulu, lalu lewat proxy CORS publik.
    try {
      const r = await fetch(url, { signal: AbortSignal.timeout(15000) });
      if (r.ok) return await r.text();
    } catch {}
    try {
      const r = await fetch('https://api.allorigins.win/raw?url=' + encodeURIComponent(url), { signal: AbortSignal.timeout(20000) });
      if (r.ok) return await r.text();
    } catch {}
    return null;
  }

  function htmlToText(html, maxChars = 2500) {
    let t = html
      .replace(/<(script|style|noscript|svg|iframe|nav|header|footer|form)[^>]*>[\s\S]*?<\/\1>/gi, ' ')
      .replace(/<!--[\s\S]*?-->/g, ' ')
      .replace(/<\/(p|div|section|article|li|ul|ol|h[1-6]|tr|table|blockquote|br)>/gi, '\n')
      .replace(/<br[^>]*>/gi, '\n')
      .replace(/<[^>]+>/g, ' ')
      .replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&lt;/g, '<')
      .replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;|&apos;/g, "'")
      .replace(/&#(\d+);/g, (_, n) => { try { return String.fromCharCode(+n); } catch { return ''; } });
    t = t.split('\n').map((l) => l.replace(/\s+/g, ' ').trim()).filter(Boolean).join('\n');
    return t.length > maxChars ? t.slice(0, maxChars) + ' …' : t;
  }

  // Pencarian untuk mode riset: Wikipedia (CORS resmi) + DuckDuckGo via proxy.
  async function webSearch(topic) {
    const found = [];
    try {
      const r = await fetch(
        'https://id.wikipedia.org/w/api.php?action=query&list=search&format=json&origin=*&srlimit=6&srsearch=' + encodeURIComponent(topic),
        { signal: AbortSignal.timeout(15000) },
      );
      const j = await r.json();
      for (const hit of (j.query?.search || [])) {
        found.push({
          title: hit.title,
          url: 'https://id.wikipedia.org/wiki/' + encodeURIComponent(hit.title.replace(/ /g, '_')),
          wikiApi: 'https://id.wikipedia.org/w/api.php?action=query&format=json&origin=*&prop=extracts&explaintext=1&exintro=0&titles=' + encodeURIComponent(hit.title),
        });
      }
    } catch {}
    if (!found.length) {
      try {
        const html = await fetchViaProxy('https://html.duckduckgo.com/html/?q=' + encodeURIComponent(topic));
        if (html) {
          const re = /class="result__a"[^>]*href="([^"]+)"[^>]*>([\s\S]*?)<\/a>/g;
          let m;
          while ((m = re.exec(html)) && found.length < 6) {
            let href = m[1].startsWith('//') ? 'https:' + m[1] : m[1];
            const uddg = (href.match(/[?&]uddg=([^&]+)/) || [])[1];
            if (uddg) href = decodeURIComponent(uddg);
            found.push({ title: htmlToText(m[2], 140), url: href });
          }
        }
      } catch {}
    }
    return found;
  }

  async function readSource(src) {
    if (src.wikiApi) {
      try {
        const r = await fetch(src.wikiApi, { signal: AbortSignal.timeout(15000) });
        const j = await r.json();
        const page = Object.values(j.query?.pages || {})[0];
        if (page?.extract) return { ...src, text: page.extract.slice(0, 2500) };
      } catch {}
    }
    const html = await fetchViaProxy(src.url);
    if (!html) return null;
    const text = htmlToText(html, 2200);
    return text.trim().length < 80 ? null : { ...src, text };
  }

  async function gatherResearch(topic) {
    const links = await webSearch(topic);
    if (!links.length) throw new Error('Tidak ada hasil pencarian untuk topik itu. Coba kata kunci lain.');
    els.status.textContent = `Membaca ${Math.min(links.length, 5)} sumber…`;
    const settled = await Promise.all(links.slice(0, 6).map(readSource));
    const readable = settled.filter(Boolean).slice(0, 5);
    if (!readable.length) throw new Error('Semua sumber gagal dibuka dari browser. Coba aplikasi Android-nya atau ulangi nanti.');
    return readable.map((s, i) => `--- SUMBER ${i + 1}: ${s.title} ---\nURL: ${s.url}\n${stripEmoji(s.text)}`).join('\n\n');
  }

  // ── generate (auto-rotasi + failover) ───────────────────────────
  function buildMessages(sourceBlock) {
    const langLabel = els.lang.options[els.lang.selectedIndex].text;
    const langCode = els.lang.value;
    const toneInstr = (TONES.find((t) => t.id === els.tone.value) || {}).instruction || '';
    const lengthInstr = (LENGTHS.find((l) => l.id === els.length.value) || {}).instruction || '';
    const system = [
      'Kamu adalah XyStudio AI, penulis dan content strategist profesional.',
      'Aturan wajib:',
      '1. Balas HANYA dengan hasil yang diminta, tanpa pembuka basa-basi.',
      '2. Gunakan Markdown rapi: judul pakai ##, poin pakai -, penekanan pakai **tebal**.',
      `3. Bahasa keluaran: ${langLabel} (kode: ${langCode}).`,
      `4. Gaya penulisan: ${toneInstr}.`,
      `5. Panjang: ${lengthInstr}.`,
      '6. Kalau brief kurang jelas, buat asumsi masuk akal dan langsung kerjakan.',
      '7. DILARANG KERAS memakai emoji atau simbol dekoratif apa pun — teks polos saja.',
    ].join('\n');

    const parts = [];
    if (engine) parts.push(`ENGINE TARGET: ${engine}\nSesuaikan parameter dan sintaks dengan engine target tersebut.\n`);
    parts.push('TUGAS:\n' + mode.instruction + '\n');
    parts.push('OBJEK / BRIEF PENGGUNA:\n"""\n' + els.brief.value.trim() + '\n"""');
    if (els.extra.value.trim()) parts.push('\nTAMBAHAN:\n"""\n' + els.extra.value.trim() + '\n"""');
    if (sourceBlock) parts.push('\n' + sourceBlock);

    return { system, user: parts.join('\n') };
  }

  function isGptOss(id) { return id.startsWith('openai/gpt-oss'); }

  function payloadFor(modelId, system, user, maxTokens) {
    const body = { model: modelId, stream: true, max_tokens: maxTokens };
    if (isGptOss(modelId)) {
      // GPT-OSS: instruksi di USER message, tanpa reasoning stream, suhu 0.6.
      body.messages = [{ role: 'user', content: `INSTRUKSI SISTEM (patuhi sepenuhnya):\n${system}\n\n${user}` }];
      body.temperature = 0.6;
      body.include_reasoning = false;
      body.reasoning_effort = 'medium';
    } else {
      body.messages = [
        { role: 'system', content: system },
        { role: 'user', content: user },
      ];
      body.temperature = parseFloat(els.temp.value);
      body.top_p = 0.95;
    }
    const info = MODELS.find((m) => m.id === modelId);
    if (info && info.ctx <= 8192) {
      body.max_tokens = Math.min(maxTokens, 1536);
      const u = body.messages[body.messages.length - 1];
      if (u.content.length > 2200) u.content = u.content.slice(0, 2200) + '\n[brief dipotong agar muat]';
    }
    return body;
  }

  function nextAutoModels() {
    let idx = 0;
    try { idx = parseInt(localStorage.getItem(ROT_STORE) || '0', 10) || 0; } catch {}
    const order = MODELS.map((_, i) => MODELS[(idx + i) % MODELS.length]);
    try { localStorage.setItem(ROT_STORE, String((idx + 1) % MODELS.length)); } catch {}
    return order;
  }

  function setBusy(v) { busy = v; syncModeUI(); els.generate.classList.toggle('stop', v); }

  // Hasil dirender utuh. Parsing markdown dibungkus try/catch supaya
  // fence yang belum tertutup tidak merusak panel hasil.
  let lastRenderAt = 0;
  function renderResult(force) {
    const now = performance.now();
    if (!force && now - lastRenderAt < 50) return;
    lastRenderAt = now;
    try {
      els.result.innerHTML = renderMd(fullText);
    } catch (err) {
      els.result.textContent = fullText;
    }
  }

  function showBadge(label) {
    answeredBy = label;
    els.badge.hidden = false;
    els.badge.textContent = 'dijawab oleh ' + label;
  }

  async function generate() {
    if (busy) { controller?.abort(); return; }

    const brief = els.brief.value.trim();
    if (!brief) {
      const msg = mode.kind === 'urlSummary' ? 'Tempel dulu URL halamannya ya.' : 'Tulis dulu brief-nya ya.';
      els.status.innerHTML = `<span class="xy-err-inline">${msg}</span>`;
      if (window.xyToast) window.xyToast(msg, 'error');
      return;
    }
    const key = currentKey();
    if (!key) {
      const msg = 'API key Groq belum ada. Buka Setelan lalu tempel key kamu.';
      els.status.innerHTML = `<span class="xy-err-inline">${msg}</span>`;
      if (window.xyToast) window.xyToast(msg, 'error');
      els.sheet.hidden = false;
      return;
    }

    setBusy(true);
    fullText = ''; answeredBy = null; els.badge.hidden = true;
    els.listen.disabled = true; els.copy.disabled = true;
    els.result.innerHTML = '<p class="muted">Sedang bekerja…</p>';

    const started = performance.now();
    controller = new AbortController();

    try {
      // Pra-pemrosesan mode riset & URL.
      let sourceBlock = null;
      if (mode.kind === 'webResearch') {
        els.status.textContent = 'Mencari sumber di web…';
        sourceBlock = 'SUMBER WEB (hasil pencarian yang sudah dibuka aplikasi):\n\n' + await gatherResearch(brief);
      } else if (mode.kind === 'urlSummary') {
        const m = brief.match(/https?:\/\/[^\s<>"')]+/);
        if (!m) throw new Error('Tidak menemukan URL di teks kamu. Tempel link lengkapnya.');
        const url = m[0].replace(/[.,;]+$/, '');
        els.status.textContent = 'Membuka ' + url + ' …';
        const html = await fetchViaProxy(url);
        if (!html) throw new Error('Halaman tidak bisa dibuka dari browser (blokir CORS). Coba aplikasi Android-nya.');
        const text = htmlToText(html, 6000);
        if (text.trim().length < 80) throw new Error('Halaman tidak punya teks yang cukup untuk diringkas.');
        sourceBlock = `ISI HALAMAN (diambil langsung oleh aplikasi dari ${url}):\n\n${text}`;
      }

      const { system, user } = buildMessages(sourceBlock);
      const maxTokens = mode.max || 2048;
      const manual = els.model.value !== 'auto';
      const attempts = manual
        ? [{ id: els.model.value, label: (MODELS.find((m) => m.id === els.model.value) || { label: els.model.value }).label }]
        : nextAutoModels();

      let lastErr = null;
      for (let i = 0; i < attempts.length; i++) {
        const target = attempts[i];
        els.status.textContent = `Menulis dengan ${target.label}…`;
        try {
          const res = await fetch(GROQ_URL, {
            method: 'POST',
            signal: controller.signal,
            headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${key}` },
            body: JSON.stringify(payloadFor(target.id, system, user, maxTokens)),
          });

          if (!res.ok) {
            const err = await res.json().catch(() => ({}));
            const e = new Error(err?.error?.message || `HTTP ${res.status}`);
            e.status = res.status;
            throw e;
          }

          showBadge(target.label);
          const reader = res.body.getReader();
          const decoder = new TextDecoder();
          let buffer = '';
          while (true) {
            const { done, value } = await reader.read();
            if (done) break;
            buffer += decoder.decode(value, { stream: true });
            const lines = buffer.split('\n');
            buffer = lines.pop() || '';
            for (const raw of lines) {
              const line = raw.trim();
              if (!line.startsWith('data:')) continue;
              const data = line.slice(5).trim();
              if (data === '[DONE]') continue;
              try {
                const json = JSON.parse(data);
                const delta = json?.choices?.[0]?.delta?.content;
                if (delta) { fullText += delta; renderResult(false); }
              } catch {}
            }
          }

          fullText = stripEmoji(fullText);
          renderResult(true);

          const secs = ((performance.now() - started) / 1000).toFixed(1);
          els.status.textContent = `Selesai dalam ${secs}s · ${countWords(fullText)} kata · ${target.label}`;
          els.listen.disabled = false; els.copy.disabled = false;
          els.edit.disabled = false; els.like.disabled = false;
          currentId = saveHistory(fullText, target.label);
          syncLikeButton();
          recordStats(fullText);
          return; // sukses
        } catch (err) {
          lastErr = err;
          if (err.name === 'AbortError') throw err;
          const retryable = !manual && !fullText && i < attempts.length - 1 &&
            (err.status === 429 || err.status >= 500 || !err.status);
          if (retryable) {
            els.status.textContent = `${target.label} bermasalah — pindah otomatis ke ${attempts[i + 1].label}…`;
            await new Promise((r) => setTimeout(r, 400));
            continue;
          }
          throw err;
        }
      }
      throw lastErr || new Error('Semua model gagal.');
    } catch (err) {
      if (err.name === 'AbortError') {
        els.status.textContent = 'Dihentikan.';
        if (fullText.trim()) {
          fullText = keepText(fullText);
          renderResult(true);
          els.listen.disabled = false; els.copy.disabled = false;
          els.edit.disabled = false; els.like.disabled = false;
          currentId = saveHistory(fullText, answeredBy || '—');
          syncLikeButton();
          recordStats(fullText);
        }
      } else {
        const friendly = (window.xyFriendlyError ? window.xyFriendlyError(err) : err.message);
        els.status.innerHTML = `<span class="xy-err-inline">${escapeHtml(friendly)}</span>`;
        if (window.xyToast) window.xyToast(friendly, 'error');
        if (fullText.trim()) {
          fullText = keepText(fullText);
          renderResult(true);
        } else {
          els.result.innerHTML = `<div class="xy-error"><strong>Tidak bisa menulis</strong><p>${escapeHtml(friendly)}</p></div>`;
        }
      }
    } finally {
      setBusy(false);
      controller = null;
    }
  }

  els.generate.addEventListener('click', generate);
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') generate();
  });

  els.copy.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(fullText);
      els.status.textContent = 'Teks berhasil disalin';
      if (window.xyToast) window.xyToast('Teks disalin.', 'ok');
    } catch {
      els.status.textContent = 'Browser memblokir clipboard. Salin manual ya.';
    }
  });

  els.clear.addEventListener('click', () => {
    fullText = '';
    currentId = null;
    els.result.innerHTML = '<p class="muted">Hasil dibersihkan.</p>';
    els.status.textContent = '';
    els.badge.hidden = true;
    els.listen.disabled = true; els.copy.disabled = true;
    els.edit.disabled = true; els.like.disabled = true;
    els.editBox.hidden = true;
    els.ttsPanel.hidden = true;
  });

  // ── Sunting & Suka (v3.1) ────────────────────────────────────────
  function persistHistory(list) {
    try { localStorage.setItem(HIST_STORE, JSON.stringify(list.slice(0, 50))); } catch {}
  }
  function findCurrent() {
    return loadHistory().find((h) => h.id === currentId) || null;
  }
  function syncLikeButton() {
    const liked = !!findCurrent()?.favorite;
    els.like.textContent = liked ? 'Disukai' : 'Suka';
    els.like.classList.toggle('active', liked);
  }
  els.like.addEventListener('click', () => {
    if (!currentId) return;
    const list = loadHistory();
    const item = list.find((h) => h.id === currentId);
    if (!item) return;
    item.favorite = !item.favorite;
    persistHistory(list);
    renderHistory();
    syncLikeButton();
  });
  els.edit.addEventListener('click', () => {
    if (!fullText.trim()) return;
    els.editText.value = fullText;
    els.editBox.hidden = false;
  });
  els.editCancel.addEventListener('click', () => { els.editBox.hidden = true; });
  els.editSave.addEventListener('click', () => {
    const next = els.editText.value.trim();
    if (!next) return;
    fullText = next;
    renderResult(true);
    const list = loadHistory();
    const item = list.find((h) => h.id === currentId);
    if (item) {
      item.output = next;
      persistHistory(list);
      renderHistory();
    }
    els.editBox.hidden = true;
    els.status.textContent = 'Hasil suntingan disimpan';
  });

  // ── Dengarkan (TTS) ─────────────────────────────────────────────
  let ttsAudio = null;
  let ttsMode = 'device'; // device | orpheus
  let ttsState = 'idle'; // idle | loading | playing | paused

  function ttsSetState(state, label) {
    ttsState = state;
    els.ttsStatus.textContent = label;
    els.ttsPlay.disabled = state === 'loading';
    els.ttsPlay.textContent = state === 'paused' ? 'Lanjut' : 'Putar';
    els.ttsPause.disabled = state !== 'playing';
    els.ttsStop.disabled = state === 'idle' || state === 'loading';
  }

  function ttsClean(text) {
    return stripEmoji(text)
      .replace(/```[\s\S]*?```/g, ' ')
      .replace(/#{1,6}\s*/g, '')
      .replace(/\*\*([^*]+)\*\*/g, '$1')
      .replace(/\*([^*]+)\*/g, '$1')
      .replace(/`([^`]+)`/g, '$1')
      .replace(/^\s*[-•]\s+/gm, '')
      .replace(/^\s*>\s*/gm, '')
      .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
      .trim();
  }

  async function ttsSpeak() {
    const text = ttsClean(fullText);
    if (!text) return;
    ttsStopInternal();
    const rate = parseFloat(els.ttsRate.value);
    const pitch = parseFloat(els.ttsPitch.value);

    if (els.lang.value === 'en') {
      // Bahasa Inggris → Orpheus dari Groq.
      ttsMode = 'orpheus';
      ttsSetState('loading', 'Menyiapkan suara Orpheus…');
      try {
        const r = await fetch(GROQ_TTS, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${currentKey()}` },
          body: JSON.stringify({
            model: 'canopylabs/orpheus-v1-english',
            input: text.slice(0, 3500),
            response_format: 'mp3',
            speed: Math.min(2, Math.max(0.5, rate)),
          }),
        });
        if (!r.ok) {
          const j = await r.json().catch(() => ({}));
          const msg = j?.error?.message || `HTTP ${r.status}`;
          const te = new Error(j?.error?.code === 'model_terms_required'
            ? 'model_terms'
            : msg);
          te.status = r.status;
          throw te;
        }
        const blob = await r.blob();
        ttsAudio = new Audio(URL.createObjectURL(blob));
        ttsAudio.onended = () => ttsSetState('idle', 'Suara siap');
        await ttsAudio.play();
        ttsSetState('playing', 'Sedang membaca — Orpheus (Groq)');
      } catch (err) {
        const friendly = window.xyFriendlyError ? window.xyFriendlyError(err) : err.message;
        ttsSetState('idle', friendly);
        if (window.xyToast) window.xyToast(friendly, 'error');
      }
      return;
    }

    // Bahasa lain → Web Speech API perangkat.
    ttsMode = 'device';
    if (!('speechSynthesis' in window)) { ttsSetState('idle', 'Browser tidak mendukung suara.'); return; }
    const utter = new SpeechSynthesisUtterance(text.slice(0, 8000));
    utter.lang = els.lang.value;
    utter.pitch = pitch;
    utter.rate = rate;
    utter.onend = () => ttsSetState('idle', 'Suara siap');
    window._xyUtter = utter;
    speechSynthesis.cancel();
    speechSynthesis.speak(utter);
    ttsSetState('playing', 'Sedang membaca — suara perangkat');
  }

  function ttsStopInternal() {
    if (ttsAudio) { try { ttsAudio.pause(); } catch {} ttsAudio = null; }
    if ('speechSynthesis' in window) speechSynthesis.cancel();
  }

  els.listen.addEventListener('click', () => {
    els.ttsPanel.hidden = !els.ttsPanel.hidden;
    if (!els.ttsPanel.hidden && ttsState === 'idle') ttsSpeak();
  });
  els.ttsPlay.addEventListener('click', () => {
    if (ttsMode === 'orpheus' && ttsAudio && ttsState === 'paused') {
      ttsAudio.play(); ttsSetState('playing', 'Sedang membaca — Orpheus (Groq)');
    } else if (ttsMode === 'device' && 'speechSynthesis' in window && speechSynthesis.paused) {
      speechSynthesis.resume(); ttsSetState('playing', 'Sedang membaca — suara perangkat');
    } else {
      ttsSpeak();
    }
  });
  els.ttsPause.addEventListener('click', () => {
    if (ttsMode === 'orpheus' && ttsAudio) { ttsAudio.pause(); ttsSetState('paused', 'Dijeda'); }
    else if ('speechSynthesis' in window) { speechSynthesis.pause(); ttsSetState('paused', 'Dijeda'); }
  });
  els.ttsStop.addEventListener('click', () => { ttsStopInternal(); ttsSetState('idle', 'Suara siap'); });

  // ── riwayat ─────────────────────────────────────────────────────
  function loadHistory() { try { return JSON.parse(localStorage.getItem(HIST_STORE) || '[]'); } catch { return []; } }
  function saveHistory(text, modelLabel) {
    if (!text.trim()) return null;
    const list = loadHistory();
    const item = {
      id: String(Date.now()), mode: mode.label, brief: els.brief.value.trim(),
      output: text, model: modelLabel, at: new Date().toISOString(), favorite: false,
    };
    list.unshift(item);
    persistHistory(list);
    renderHistory();
    return item.id;
  }
  function renderHistory() {
    const list = loadHistory();
    if (!list.length) { els.history.innerHTML = '<p class="muted small">Belum ada riwayat.</p>'; return; }
    els.history.innerHTML = list.slice(0, 12).map((h) => `
      <div class="hist${h.favorite ? ' fav' : ''}" data-id="${h.id}">
        <div class="hist-top">
          <span class="hist-mode">${escapeHtml(h.mode)}</span>
          <span class="muted small">${h.favorite ? '<span class="hist-heart">Disukai</span> · ' : ''}${new Date(h.at).toLocaleDateString('id-ID')} · ${escapeHtml(h.model || '')}</span>
        </div>
        <p class="hist-brief">${escapeHtml((h.brief || '').slice(0, 90))}</p>
      </div>`).join('');
    els.history.querySelectorAll('.hist').forEach((el) => {
      el.addEventListener('click', () => {
        const item = list.find((x) => x.id === el.dataset.id);
        if (!item) return;
        fullText = item.output;
        currentId = item.id;
        renderResult(true);
        els.brief.value = item.brief;
        showBadge(item.model || '—');
        els.listen.disabled = false; els.copy.disabled = false;
        els.edit.disabled = false; els.like.disabled = false;
        syncLikeButton();
        els.status.textContent = `Dibuka dari riwayat · ${item.mode}`;
      });
    });
  }

  renderHistory();
  renderStats();
  syncModeUI();
</script>

<style>
  .app-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; padding: 26px 0 60px; align-items: start; min-width: 0; }
  .pane { padding: 22px; }
  .pane-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 9px; }
  .pane-top .label { margin: 0; }
  .modes { display: flex; flex-wrap: wrap; gap: 7px; }
  .engines { display: flex; flex-wrap: wrap; gap: 7px; }
  .engine-chip.active { background: linear-gradient(120deg, var(--violet), var(--cyan)); color: #fff; border-color: transparent; }
  .opts { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 14px; }
  .opts label { display: flex; flex-direction: column; gap: 6px; }
  .opts select, .opts input[type="range"] { height: 46px; }
  .switch-line { display: flex; align-items: center; gap: 8px; height: 46px; font-size: 13px; }
  .switch-line input[type="range"] { flex: 1; height: auto; }

  .model-badge { font-size: 11px; font-weight: 700; color: var(--cyan);
                 border: 1px solid rgba(34,211,238,.4); background: rgba(34,211,238,.08);
                 padding: 3px 10px; border-radius: 999px; }

  .tts-panel { display: flex; flex-wrap: wrap; align-items: center; gap: 10px;
               padding: 10px 12px; margin: 8px 0; border-radius: 14px;
               background: rgba(124,92,255,.08); border: 1px solid rgba(124,92,255,.3);
               font-size: 12.5px; }
  .tts-panel .tts-controls { display: flex; gap: 6px; }
  .tts-panel .tts-slider { display: flex; align-items: center; gap: 6px; color: var(--muted); }
  .tts-panel input[type="range"] { width: 80px; }
  .sm-chip { padding: 5px 10px !important; font-size: 11.5px !important; }

  .result-pane { display: flex; flex-direction: column; min-height: 480px; }
  .result-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; margin-bottom: 6px; flex-wrap: wrap; }
  .result-actions { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
