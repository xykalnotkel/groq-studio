---
import { APP } from '../data/app.js';
import BugReportModal from '../components/BugReportModal.astro';
import ChannelPopup from '../components/ChannelPopup.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  current?: string;
}
const {
  title = `${APP.name} — ${APP.tagline}`,
  description = APP.description,
  current = '',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, APP.siteUrl).href;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${APP.siteUrl}/logo.png`} />
    <meta name="theme-color" content="#0a0a14" />
    <style is:global>
      @import '../styles/global.css';
    </style>
  </head>
  <body>
    <div class="morph-backdrop" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>

    <SiteHeader current={current} />
    <slot />
    <SiteFooter />

    <ChannelPopup />
    <BugReportModal />
    <script>
      import '../scripts/xy-ui.js';
    </script>
  </body>
</html>
