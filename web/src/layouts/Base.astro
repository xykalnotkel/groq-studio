---
import { APP } from '../data/app.js';
import ChannelPopup from '../components/ChannelPopup.astro';

interface Props {
  title?: string;
  description?: string;
}
const { title = `${APP.name} — ${APP.tagline}`, description = APP.description } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0a0a14" />
    <style is:global>
      @import '../styles/global.css';
    </style>
  </head>
  <body>
    <div class="morph-backdrop" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>

    <slot />

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-row">
          <div class="footer-brand">
            <img src="/logo.png" alt="" width="34" height="34" />
            <div>
              <strong>{APP.name}</strong>
              <div class="muted small">{APP.tagline}</div>
            </div>
          </div>
          <nav class="footer-links">
            <a href="/">Beranda</a>
            <a href="/app">Web App</a>
            <a href="/about">Tentang</a>
            <a href={APP.waChannelUrl} target="_blank" rel="noopener">Saluran WA</a>
            <a href={APP.bugReportUrl} target="_blank" rel="noopener">Lapor Bug</a>
            <a href={APP.githubUrl} target="_blank" rel="noopener">GitHub</a>
          </nav>
        </div>
        <div class="footer-credit">
          <span class="credit-pill">{APP.credit}</span>
          <span class="muted small">
            Ditenagai Groq · v{APP.version}
          </span>
        </div>
      </div>
    </footer>

    <ChannelPopup />

    <style>
      .site-footer {
        margin-top: 80px;
        padding: 30px 0 40px;
        border-top: 1px solid var(--line);
        background: rgba(10, 10, 20, 0.6);
      }
      .footer-row {
        display: flex; flex-wrap: wrap; gap: 20px;
        align-items: center; justify-content: space-between;
      }
      .footer-brand { display: flex; align-items: center; gap: 11px; }
      .footer-brand img { border-radius: 9px; }
      .footer-links { display: flex; flex-wrap: wrap; gap: 18px; font-size: 13.5px; }
      .footer-links a { color: var(--muted); transition: color .2s; }
      .footer-links a:hover { color: var(--violet); }
      .footer-credit {
        margin-top: 22px; padding-top: 18px;
        border-top: 1px solid var(--line);
        display: flex; flex-wrap: wrap; gap: 12px;
        align-items: center; justify-content: space-between;
      }
      .credit-pill {
        display: inline-flex; align-items: center; gap: 7px;
        padding: 6px 14px; border-radius: 999px;
        background: linear-gradient(120deg, rgba(124,92,255,.18), rgba(34,211,238,.18));
        border: 1px solid rgba(124, 92, 255, .32);
        font-size: 12.5px; font-weight: 800; letter-spacing: .4px;
      }
      .small { font-size: 12.5px; }
    </style>
  </body>
</html>
